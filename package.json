{
  "name": "@thixpin/md2book",
  "version": "0.0.0",
  "description": "Build print PDF, EPUB and web editions of Markdown books, with first-class Myanmar script support.",
  "type": "module",
  "license": "MIT",
  "author": "thixpin",
  "engines": {
    "node": ">=26"
  },
  "bin": {
    "book-build": "dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "assets"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:release": "vitest run --config vitest.release.config.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "equivalence": "node scripts/equivalence.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "equivalence:web": "node scripts/equivalence-web.ts",
    "equivalence:epub-qa": "node scripts/equivalence-epub-qa.ts"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "entities": "^8.1.0",
    "fast-xml-parser": "^5.11.1",
    "fontkit": "^2.0.4",
    "markdown-it": "^15.0.2",
    "playwright": "^1.63.0",
    "prismjs": "^1.30.0",
    "sharp": "^0.35.5",
    "unicode-name": "^1.2.1",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/fontkit": "^2.0.9",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.3",
    "@types/prismjs": "^1.26.6",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "eslint": "^10.11.0",
    "parse5": "^8.0.1",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
