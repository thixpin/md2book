{
  "name": "@thixpin/md2book",
  "version": "0.3.1",
  "description": "Build print PDF, EPUB and web editions of Markdown books, with first-class Myanmar script support.",
  "keywords": [
    "book",
    "markdown",
    "pdf",
    "epub",
    "ebook",
    "publishing",
    "myanmar",
    "burmese",
    "unicode",
    "paged-media",
    "cli"
  ],
  "type": "module",
  "license": "MIT",
  "author": "thixpin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thixpin/md2book.git"
  },
  "homepage": "https://md2book.thixpin.me",
  "bugs": {
    "url": "https://github.com/thixpin/md2book/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=26"
  },
  "bin": {
    "md2book": "dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "assets"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:release": "vitest run --config vitest.release.config.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "equivalence": "node scripts/equivalence.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "equivalence:web": "node scripts/equivalence-web.ts",
    "equivalence:epub-qa": "node scripts/equivalence-epub-qa.ts",
    "equivalence:pdf": "node scripts/equivalence-pdf.ts",
    "package:check": "node scripts/package-check.ts",
    "prepublishOnly": "npm run check && npm run build",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "test:perf": "vitest run --config vitest.perf.config.ts"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.9",
    "commander": "^15.0.0",
    "entities": "^8.1.0",
    "fast-xml-parser": "^5.11.1",
    "fontkit": "^2.0.4",
    "markdown-it": "^15.0.2",
    "pagedjs": "0.4.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "playwright": "^1.63.0",
    "prismjs": "^1.30.0",
    "sharp": "^0.35.5",
    "unicode-name": "^1.2.1",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/fontkit": "^2.0.9",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.3",
    "@types/prismjs": "^1.26.6",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.11.0",
    "parse5": "^8.0.1",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.2"
  }
}
