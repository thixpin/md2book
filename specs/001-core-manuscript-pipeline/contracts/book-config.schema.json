{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "md2book book configuration",
  "description": "Compatibility surface (Constitution, Engineering Standards). Paths resolve relative to this file. Unknown keys at any level produce a warning naming the key path, not an error; wrong types and missing required keys stop the run.",
  "type": "object",
  "required": [
    "title",
    "author",
    "year",
    "identifier",
    "output_name",
    "cover",
    "chapter_glob"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "subtitle": {
      "type": "string"
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "publisher": {
      "type": "string",
      "description": "Empty means omitted."
    },
    "year": {
      "type": "string"
    },
    "isbn": {
      "type": "string",
      "description": "Empty means omitted."
    },
    "language": {
      "enum": [
        "my",
        "en"
      ],
      "default": "my",
      "type": "string"
    },
    "identifier": {
      "type": "string",
      "minLength": 1
    },
    "output_name": {
      "type": "string",
      "minLength": 1
    },
    "cover": {
      "type": "string",
      "minLength": 1,
      "description": "PNG or JPEG. Must exist."
    },
    "web_back_cover": {
      "type": "string",
      "description": "The web edition's back cover image; without it a plain one is generated."
    },
    "web_favicon": {
      "type": "string",
      "description": "An SVG icon for the web edition; without it an open book in the cover's edge colour."
    },
    "web_url": {
      "type": "string",
      "pattern": "^https?:\\/\\/[^/\\s]+",
      "description": "The web edition's public URL: absolute http(s); its path is the site's path (GitHub project Pages)."
    },
    "web_description": {
      "type": "string",
      "description": "The web edition's page description (default: subtitle, then title)."
    },
    "chapter_glob": {
      "type": "string",
      "minLength": 1
    },
    "part_glob": {
      "type": "string"
    },
    "web_published_chapters": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "web_analytics": {
      "description": "Opt-in analytics for the web edition: provider google (id G-…), plausible (site domain), goatcounter (site code) or cloudflare (token). Absent: no analytics.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "const": "google"
            },
            "id": {
              "type": "string",
              "pattern": "^G-[A-Z0-9]{4,}$"
            }
          },
          "required": [
            "provider",
            "id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "const": "plausible"
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+$"
            }
          },
          "required": [
            "provider",
            "id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "const": "goatcounter"
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$"
            }
          },
          "required": [
            "provider",
            "id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "const": "cloudflare"
            },
            "id": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            }
          },
          "required": [
            "provider",
            "id"
          ]
        }
      ]
    },
    "recto_chapter_start": {
      "type": "boolean",
      "default": false
    },
    "running_headers": {
      "type": "boolean",
      "default": true,
      "description": "Deprecated (removed before 1.0): use running.top."
    },
    "end_image": {
      "type": "string"
    },
    "end_image_after": {
      "type": "string"
    },
    "font_set": {
      "enum": [
        "sans",
        "serif"
      ],
      "default": "sans",
      "description": "Deprecated (removed before 1.0): use font.family.",
      "type": "string"
    },
    "page": {
      "description": "PDF page size preset (spec 006). Default: default (170 x 240 mm).",
      "type": "object",
      "properties": {
        "size": {
          "type": "string",
          "enum": [
            "default",
            "a5",
            "b5",
            "a4",
            "letter"
          ]
        }
      }
    },
    "font": {
      "description": "Font family and PDF font size presets (spec 006). Defaults: the language default family (or font_set), size m.",
      "type": "object",
      "properties": {
        "family": {
          "type": "string",
          "enum": [
            "noto-sans-myanmar",
            "noto-serif-myanmar",
            "masterpiece-uni-round",
            "padauk",
            "noto-sans",
            "noto-serif"
          ]
        },
        "size": {
          "type": "string",
          "enum": [
            "xs",
            "s",
            "m",
            "l",
            "xl"
          ]
        }
      }
    },
    "running": {
      "description": "Running heads and feet of the PDF and web edition: top/bottom × inner/center/outer, each author, book-title, chapter-title, page-number or none. Defaults: top chapter-title / none / author, bottom book-title / none / page-number.",
      "type": "object",
      "properties": {
        "top": {
          "type": "object",
          "properties": {
            "inner": {
              "type": "string",
              "enum": [
                "author",
                "book-title",
                "chapter-title",
                "page-number",
                "none"
              ]
            },
            "center": {
              "type": "string",
              "enum": [
                "author",
                "book-title",
                "chapter-title",
                "page-number",
                "none"
              ]
            },
            "outer": {
              "type": "string",
              "enum": [
                "author",
                "book-title",
                "chapter-title",
                "page-number",
                "none"
              ]
            }
          }
        },
        "bottom": {
          "type": "object",
          "properties": {
            "inner": {
              "type": "string",
              "enum": [
                "author",
                "book-title",
                "chapter-title",
                "page-number",
                "none"
              ]
            },
            "center": {
              "type": "string",
              "enum": [
                "author",
                "book-title",
                "chapter-title",
                "page-number",
                "none"
              ]
            },
            "outer": {
              "type": "string",
              "enum": [
                "author",
                "book-title",
                "chapter-title",
                "page-number",
                "none"
              ]
            }
          }
        }
      }
    },
    "code_root": {
      "type": "string",
      "description": "Base for snippet paths. Default: nearest ancestor with .git, else this file's directory."
    },
    "strings": {
      "type": "object",
      "description": "Series strings. Defaults come from the language profile; explicit values win.",
      "properties": {
        "chapter_label": {
          "type": "string",
          "minLength": 1
        },
        "chapter_digits": {
          "enum": [
            "myanmar",
            "ascii"
          ],
          "type": "string"
        },
        "contents_heading": {
          "type": "string"
        },
        "page_names": {
          "type": "object",
          "properties": {
            "cover": {
              "type": "string"
            },
            "contents": {
              "type": "string"
            },
            "back_cover": {
              "type": "string"
            }
          }
        },
        "callout_titles": {
          "type": "object",
          "properties": {
            "note": {
              "type": "string"
            },
            "warning": {
              "type": "string"
            },
            "try": {
              "type": "string"
            }
          }
        },
        "licence_text": {
          "type": "string"
        },
        "typeface_line": {
          "type": "string"
        },
        "storage_prefix": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "back_cover": {
      "type": "string",
      "description": "Deprecated (removed before 1.0): old name of web_back_cover."
    },
    "favicon": {
      "type": "string",
      "description": "Deprecated (removed before 1.0): old name of web_favicon."
    },
    "description": {
      "type": "string",
      "description": "Deprecated (removed before 1.0): old name of web_description."
    }
  }
}
